{
  "name": "uno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace @uno/server",
    "dev:web": "npm run dev --workspace @uno/web",
    "build": "npm run build --workspace @uno/web && npm run build --workspace @uno/server",
    "start": "npm run start --workspace @uno/server",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/protocol --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "format": "prettier --write --ignore-unknown \"apps/**\" \"packages/**\" \"e2e/**\" \"scripts/**\" \".github/**\" \"*.{json,ts,md,yml,yaml}\"",
    "format:check": "prettier --check --ignore-unknown \"apps/**\" \"packages/**\" \"e2e/**\" \"scripts/**\" \".github/**\" \"*.{json,ts,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
